# Application Environment ('development', 'production', 'test')
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/ricoz_dev
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ricoz_dev?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ricoz_dev

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:3000

# JWT Authentication Secrets and Expiration
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=15m

# Cookie Secret
COOKIE_SECRET=your_secure_cookie_secret_key_at_least_32_characters
