# Application Environment ('development', 'production', 'test')
NODE_ENV=development

# Server Port (Render automatically provides process.env.PORT in production)
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Atlas Example: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
# Local Example: mongodb://127.0.0.1:27017/ricoz_dev
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ricoz_prod?retryWrites=true&w=majority

# Allowed Client Origin(s) for CORS (comma-separated supported for multiple origins)
# Production Example: https://your-app.vercel.app
CLIENT_URL=http://localhost:3000

# JWT Authentication Secrets and Expiration (REQUIRED in production - generate strong random strings)
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_characters
JWT_EXPIRES_IN=15m

# Cookie Secret (REQUIRED in production - generate a strong random string)
COOKIE_SECRET=replace_with_a_strong_random_cookie_secret_at_least_32_characters
